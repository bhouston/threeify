{
  "files": [],
  "references": [
    { "path": "./tools/glsl-transpiler" },
    { "path": "./tools/esbuild-plugin-glsl-transpiler" },
    { "path": "./tools/build" },
    { "path": "./tools/examples-server" },
    { "path": "./packages/math" },
    { "path": "./packages/core" },
    { "path": "./packages/scene" },
    { "path": "./packages/layer-compositor" },
    { "path": "./examples" }
  ],
  "compilerOptions": {
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2020", "dom"],
    "typeRoots": ["node_modules/@types"],

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "noImplicitAny": true,
    "noImplicitThis": true,
    "alwaysStrict": true,

    "resolveJsonModule": false, // causes problems by hoisting json files, and src to the root of the dist folder
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    "declaration": true,
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "allowJs": false,
    "incremental": true,
    "composite": true
  }
}
