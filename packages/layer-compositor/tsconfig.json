{
  "extends": "../../tsconfig.json",
  "references": [{ "path": "../math" }, { "path": "../core" }],
  "include": ["src"],
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "composite": true,
    "plugins": [
      {
        "transform": "@threeify/typescript-plugin-glsl-transpiler"
      }
    ]
  },
  "glslTranspiler": {
    "rootDir": "src",
    "outDir": "src"
  }
}
