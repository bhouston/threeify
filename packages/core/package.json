{
  "name": "@threeify/core",
  "version": "4.0.4",
  "gitHead": "e851f7c9ab6e9ce71a875d293e6318bf5c261bc0",
  "description": "Typescript 3D Library loosely based on three.js",
  "source": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "scripts": {
    "build": "glsl-transpiler -r src -o src && tsc",
    "watch": "glsl-transpiler -r src -o src --watch & tsc --watch"
  },
  "dependencies": {
    "@threeify/math": "workspace:*"
  },
  "devDependencies": {
    "@threeify/build": "workspace:*",
    "@threeify/glsl-transpiler": "workspace:*"
  }
}
