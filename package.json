{
  "name": "threeify",
  "version": "0.0.1",
  "private": true,
  "description": "Typescript 3D Library loosely based on three.js",
  "keywords": [
    "3D",
    "threeify",
    "webgl",
    "webgpu"
  ],
  "homepage": "http://bhouston.github.com/threeify",
  "bugs": {
    "url": "https://github.com/bhouston/threeify/issues"
  },
  "license": "ISC",
  "author": "threeify authors",
  "repository": {
    "type": "git",
    "url": "https://github.com/bhouston/threeify.git"
  },
  "type": "module",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "build": "glsl-transpiler -b -c tsconfig.json && tsgo -b",
    "watch": "glsl-transpiler -b -w -c tsconfig.json & tsgo -b --watch & pnpm --filter threeify-examples run serve & pnpm --filter examples-server run bundle:watch",
    "clean:node_modules": "node scripts/clean.js --node_modules",
    "clean:dist": "node scripts/clean.js --dist",
    "clean": "node scripts/clean.js --node_modules --dist",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "docs": "typedoc",
    "test": "jest",
    "publish": "pnpm run clean:dist && pnpm run build && pnpm test && pnpm -r publish --filter '!@private'"
  },
  "dependencies": {
    "@gltf-transform/core": "^2.5.1",
    "@gltf-transform/extensions": "^2.5.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/offscreencanvas": "^2019.7.0",
    "esbuild": "0.18.3",
    "husky": "^8.0.3",
    "jest": "^29.5.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.59.0",
    "semantic-release": "^22.0.8",
    "@typescript/native-preview": "7.0.0-dev.20251229.1",
    "ts-jest": "^29.1.0",
    "ts-jest-resolver": "^2.0.1",
    "ts-node": "^10.9.1",
    "typescript": "5.1.3",
    "vite": "^4.1.4"
  },
  "packageManager": "pnpm@8.15.5"
}
